# --- Supabase (leave blank to run in local DEMO MODE with a file-backed store) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Used ONLY by scripts/seed (never imported by app code paths reachable from the browser).
SUPABASE_SERVICE_ROLE_KEY=

# --- AI assistant (server-only). Without a key the app uses the deterministic rule-based engine. ---
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
ANTHROPIC_MODEL=

# --- App ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Demo mode only: where the JSON store lives (default .data/demo-store.json)
DEMO_STORE_PATH=
